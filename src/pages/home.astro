---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE_0, SITE_TITLE_1, SITE_DESCRIPTION, SITE_IMAGE } from '../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE_0+" "+SITE_TITLE_1} description={SITE_DESCRIPTION} image={SITE_IMAGE} />
	</head>
	<body>
		<Header />
		<main>
			<p id="intro-text">
				Ceci est le site officiel du Comité pro-nucléaire de <a title="Cégep Gérald-Godin" href="https://www.cgodin.qc.ca/" target="_blank">GG</a>!<br> Merci de visiter notre site web. 
			</p>
			<hr style="border: 2px solid rgb(var(--gray));">
			<section id="links">
				<div class="grid">
					<div class="grid-item">
						<p>
							Test 
						</p>
					</div>
					<div class="grid-item">
						<p>
							Test 
						</p>
					</div>
					<div class="grid-item">
						<p>
							Test 
						</p>
					</div>
				</div>
			</section>
			<hr style="border: 2px solid rgb(var(--gray));">
			<section class="specs">
				<div class="specs-visual">
				</div>
				<div class="specs-content">
					<h2>Caractéristiques</h2>
				</div>
			</section>
		</main>
		<Footer />
	</body>
	<style>
		#intro-text {
			min-height: 70vh;
		}
		#links {
			padding: 6rem 0;
		}
		.specs {
			display: flex;
			align-items: center;
			gap: 4rem;
		}
		.specs-visual {
			background: rgb(var(--gray-light));
			border: 1px solid rgb(var(--gray));
			border-radius: 1.5rem;
		}
		.specs-content {
			width: 50%;
		}
		.grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 2rem;
		}
		.grid-item {
			text-align: center;
			padding: 2.5rem;
			background: rgb(var(--gray-light));
			border-radius: 1.5rem;
			border: 1px solid rgb(var(--gray));
			transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.grid-item:hover {
			translate: 0 -8px;
		}
	</style>
</html>
