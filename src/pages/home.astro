---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE_0, SITE_TITLE_1, SITE_DESCRIPTION, SITE_IMAGE } from '../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE_0+" "+SITE_TITLE_1} description={SITE_DESCRIPTION} image={SITE_IMAGE} />
	</head>
	<body>
		<Header />
		<main>
			<p id="intro-text">
				Ceci est le site officiel du Comité pro-nucléaire de <a title="Cégep Gérald-Godin" href="https://www.cgodin.qc.ca/" target="_blank">GG</a>!<br> Merci de visiter notre site web. 
			</p>
			<hr>
			<section id="links">
				<div class="grid">
					<div class="grid-item">
						<p>
							Test 
						</p>
					</div>
					<div class="grid-item">
						<p>
							Test 
						</p>
					</div>
					<div class="grid-item">
						<p>
							Test 
						</p>
					</div>
				</div>
			</section>
			<hr>
			<section class="specs">
				<div class="specs-visual">
				</div>
				<div class="specs-content">
					<h3>Caractéristiques</h3>
					<div class="specs-list">
                        <div class="spec-item">
                            <span class="spec-label">Display</span>
                            <span class="spec-value">1.28" Round OLED (240x240)</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">Motor Type</span>
                            <span class="spec-value">Hollow-shaft Brushless DC</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">Encoder</span>
                            <span class="spec-value">High-precision Magnetic</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">Connectivity</span>
                            <span class="spec-value">USB-C &amp; Bluetooth LE</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">Microcontroller</span>
                            <span class="spec-value">ESP32-S3 Dual-Core</span>
                        </div>
                    </div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
	<style>
		main hr {
			border-top: 3px solid rgb(var(--gray));
    		margin: 3rem 0;
		}
		#intro-text {
			min-height: 70vh;
		}
		#links {
			padding: 4rem 0;
		}
		.specs {
			display: flex;
			align-items: center;
			gap: 4rem;
		}
		.specs-visual {
			width: 582px;
			height: 582px;
			background: rgb(var(--gray-light));
			border: 1px solid rgb(var(--gray));
			border-radius: 1.5rem;
		}
		.specs-content {
			width: 50%;
		}
		.specs-list {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		.spec-item {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 1rem;
			border-bottom: 1px solid var(--astro-border);
		}
		.spec-label {
			color: rgb(var(--gray));
		}
		.spec-value {
			color: rgb(var(--black));
    		font-weight: 700;
		}
		.grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 2rem;
		}
		.grid-item {
			text-align: center;
			padding: 2.5rem;
			background: rgb(var(--gray-light));
			border-radius: 1.5rem;
			border: 1px solid rgb(var(--gray));
			transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.grid-item:hover {
			translate: 0 -8px;
		}
	</style>
</html>
