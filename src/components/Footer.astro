<style>
	footer {
		margin-top: 4em;
    	padding: 0.5em 1em 1em;
		background: linear-gradient(var(--gray-gradient));
		color: rgb(var(--gray));
		border-top: 3px solid;
	}
	.footer-container {
		max-width: 720px;
		margin: auto;
	}
	.footer-section h5 {
		text-align: left;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, auto));
		justify-content: center;
		gap: 3rem;
	}
	.footer-list {
		list-style: none;
		text-align: left;
		font-size: 15.5px;
	}
	.footer-list a {
		text-decoration: none;
		transition: 0.2s;
	}
	.footer-list a:hover {
		color: rgb(var(--white));
    	text-shadow: 0 0 5px rgb(var(--accent-dark));
	}
	.footer-newsletter {
		display: flex;
		justify-content: left;
	}
	.footer-low {
		display: flex;
		flex-wrap: wrap;
		flex-direction: column;
		align-content: center;
		font-size: 1rem;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
