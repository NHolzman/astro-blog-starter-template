---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE_0, SITE_TITLE_1 } from '../consts';
---

<header>
	<nav>
		<h2 title="Accueil">
			<a title="Accueil" href="/home">
				<img id="logo" width="50" height="50" src="/logo.jpg">
			</a>
			<a id="titre0" href="/home">{SITE_TITLE_0}</a>
			<a id="titre1" href="/home">{SITE_TITLE_1}</a>
		</h2>
		<div class="internal-links">
			<!-- <HeaderLink href="/home">Home</HeaderLink> -->
			<!-- <HeaderLink href="/blog">Blog</HeaderLink> -->
			<HeaderLink href="/about">À propos</HeaderLink>
			<HeaderLink href="/projet">Projet actuel</HeaderLink>
		</div>
		<label for="themecheck" id="themelabel">
			<svg width="24px" height="24px" viewBox="0 0 24 24" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
            	<path d="M12,22 C17.5228475,22 22,17.5228475 22,12 C22,6.4771525 17.5228475,2 12,2 C6.4771525,2 2,6.4771525 2,12 C2,17.5228475 6.4771525,22 12,22 Z M12,20.5 L12,3.5 C16.6944204,3.5 20.5,7.30557963 20.5,12 C20.5,16.6944204 16.6944204,20.5 12,20.5 Z"></path>
			</svg>
		</label>
		<input type="checkbox" id="themecheck">
		<label for="burgercheck" id="burgerlabel">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="menu" aria-hidden="true" class="lucide lucide-menu">
					<path d="M4 5h16 M4 12h16 M4 19h16"></path>
				</svg>
		</label>
		<input type="checkbox" id="burgercheck">
		<div class="burger-panel">
				<ul>
					<li><a href="/about">À propos</a></li>
					<li><a href="/projet">Projet actuel</a></li>
				</ul>
		</div>
	</nav>
</header>
<style>
	header {
		z-index: 10;
		position: fixed;
		width: 100%;
		margin: 0;
		padding: 0 1em;
		background: transparent;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		height: 4em;
		align-content: center;
	}
	header:before {
		z-index: -1;
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: transparent;
		backdrop-filter: blur(10px);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		translate: 50px;
		height: 100%;
		align-content: center;
	}
	h2:hover {
		text-shadow: 0 0 8px rgba(0, 255, 200, 0.55);
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		white-space: nowrap;
		padding: 1em 0 !important;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
	}
	nav a {
		padding: 0 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
		height: 95%;
    	align-content: center;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		margin: 0 auto;
		font-size: 0.85em;
		height: 100%;
	}
	#burgercheck, #themecheck {
		display: none;
	}
	#burgerlabel {
		padding-right: 1em;
		margin-left: auto;
		display: none;
	}
	#themelabel {
		margin: auto 5%;
	}
	.burger-panel {
		width: 0;
		height: 100%;
		position: relative;
		translate: 100%;
		transition: 0.25s;
	}
	.burger-panel ul {
		list-style-type: none;
		line-height: 2.5;
		background-color: transparent;
		border-radius: 0 0 0 30px;
		padding: 1em;
		translate: 0 -1em; /*Align with top of header*/
		backdrop-filter: blur(10px);
	}
	.burger-panel a:hover {
		background-color: gainsboro;
	}
	#logo {
		min-width: 50px !important;
		min-height: 50px !important;
		position: absolute !important;
  		translate: -100% -30% !important;
		transition: 0.5s;
		transition-property: scale, border-radius, border-color;
		border-style: dotted;
		border-radius: 0;
		border-width: 2px;
		border-color: white;
	}
	h2:hover #logo {
		scale: 1.05;
		border-radius: 50%;
		border-color: #00ff73;
	}
	@media  (max-width: 625px) {
		header {
			padding-left: 0;
			padding-right: 0;
		}
		h2 {
			max-width: min-content;
			padding-bottom: 0 !important;
		}
		#logo {
			translate: -100% -12.5% !important;
		}
	}
	@media  (max-width: 540px) {
		.internal-links, .internal-links a ~ * {
			display: none !important;
		}
		#burgerlabel {
			display: block;
		}
		#burgercheck:checked ~ .burger-panel {
			width: auto;
			translate: 0%;
		}
	}
	@media  (max-width: 420px) {
		#titre0, #titre1 {
			display: none;
		}
		#logo {
			translate: -75% -50% !important;
		}
	}
	@media  (max-width: 380px) {
		#burgerlabel {
			margin-left: 0;
		}
	}
</style>
